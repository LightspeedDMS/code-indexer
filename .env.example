# ============================================
# CREDENTIALS (Local Development Only)
# ============================================
# In AWS Lambda, credentials are fetched from AWS Secrets Manager.
# Secret name follows the pattern: claude-batch-server-sourcename-mcp-{env}
#
# For local development, set these values below.
# TEMPLATE: Replace with the actual credential fields your API requires.

# SOURCENAME_API_KEY=your-api-key-here
# SOURCENAME_API_SECRET=your-api-secret-here

# ============================================
# SOURCENAME CONFIGURATION
# ============================================
# TEMPLATE: Add service-specific config vars here.
# SOURCENAME_BASE_URL=https://api.sourcename.example.com

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
