# syntax=docker/dockerfile:1
# Development image — installs all deps (including devDeps) and runs NestJS in
# watch mode. Source is mounted at runtime via docker-compose volume so file
# changes trigger instant recompilation without a Docker rebuild.

FROM node:22-bullseye-slim

WORKDIR /usr/src/app

RUN apt-get update && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json nest-cli.json tsconfig*.json ./

RUN --mount=type=secret,id=npmrc,target=/root/.npmrc \
    HUSKY=0 npm ci

# src/ is bind-mounted at runtime
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "node_modules/.bin/nest", "start", "--watch"]
