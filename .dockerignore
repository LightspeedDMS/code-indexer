# Keep the build context small + reproducible. The image needs only:
#   third_party/hnswlib (custom native build), src/ (the package), pyproject.toml, README.md
.git
.gitlab-ci.yml
.github
tests/
test-fixtures/
docs/
examples/
third_party/hnswlib/examples/
third_party/hnswlib/tests/
**/__pycache__/
**/*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
*.md
!README.md
