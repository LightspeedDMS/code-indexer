{
  "name": "sourcename-mcp",
  "version": "0.0.1",
  "description": "MCP spoke service for SOURCENAME integration in the hub-and-spoke agent architecture",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "rm -f .prettierrc .eslintrc.js",
    "prepare": "husky",
    "prebuild": "rimraf dist",
    "tsc": "npm run build",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:test": "eslint \"test/**/*.ts\"",
    "prettier": "prettier --check \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "serverless-build:dev": "sls package --stage dev --region us-west-2 --verbose",
    "docs:generate": "ts-node scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.370.0",
    "@lightspeed/nestjs-common-components": "1.5.5",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.1.1",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.1.1",
    "@nestjs/platform-express": "^10.1.1",
    "@nestjs/swagger": "^7.4.2",
    "@vendia/serverless-express": "^4.10.4",
    "aws-lambda": "^1.0.7",
    "axios": "^1.6.2",
    "js-yaml": "^4.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "nestjs-pino": "^3.5.0",
    "pino": "^9.1.0",
    "pino-http": "^8.5.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@lightspeed/code-formatting-library": "^0.2.4",
    "@nestjs/cli": "^10.1.10",
    "@nestjs/schematics": "^10.0.1",
    "@nestjs/testing": "^10.1.1",
    "@types/aws-lambda": "^8.10.115",
    "@types/js-yaml": "^4.0.9",
    "@types/express": "^4.17.17",
    "@types/jest": "29.5.2",
    "@types/node": "20.2.5",
    "@types/supertest": "^2.0.12",
    "@types/webpack-node-externals": "^3.0.0",
    "aws-sdk-client-mock": "^3.1.0",
    "husky": "^9.1.7",
    "jest": "29.5.0",
    "jest-junit": "^13.0.0",
    "lint-staged": "^15.2.11",
    "serverless": "^3.39.0",
    "serverless-deployment-bucket": "^1.6.0",
    "serverless-plugin-canary-deployments": "^0.8.0",
    "serverless-prune-plugin": "^2.0.2",
    "serverless-webpack": "^5.11.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "ts-jest": "29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.0.1",
    "typescript": "^5.2.2",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1",
    "webpack-merge": "^5.9.0",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": ["/node_modules/", "/test/"],
    "passWithNoTests": true,
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts",
      "!src/serverless.ts",
      "!src/**/*.module.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 50,
        "branches": 40,
        "functions": 50,
        "lines": 50
      }
    },
    "testEnvironment": "node"
  },
  "overrides": {
    "serverless-plugin-canary-deployments": {
      "flat": "^5.0.2"
    }
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
